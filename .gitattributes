# na CRLF a rozbil bajtovou shodu s originálem (a dělal šum v diffech).
* text=auto eol=lf

# Referenční kopie původní aplikace se nesmí měnit vůbec – je to důkaz parity.
reference/index-original.html -text

# Data míst: odsazená dvěma mezerami, aby diff ukázal jedno změněné pole,
# ne celý objekt. Do buildu se stejně dostanou bez mezer.
src/data/places.json text eol=lf
